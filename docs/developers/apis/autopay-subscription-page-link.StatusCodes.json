{"responses":{"200":{"content":{"application/json":{"schema":{"type":"object","properties":{"page_token":{"type":"string","description":"The signed token that identifies the subscription on the self-service page. Use it on its own only if you build the customer-facing URL yourself; otherwise hand out `page_url`.\n"},"page_url":{"type":"string","description":"The complete link to hand to the customer. AutoPay builds it from your primary domain, the subscription's language and `page_token`.\n\nAnyone holding this link can act on the subscription, so treat it as a credential and deliver it only to the subscription's own customer. See [Customer Self-Service Page](/developers/payments/autopay/#customer-self-service-page).\n"}},"required":["page_token","page_url"],"description":"The customer's current self-service link. Reading it never changes it, so a link the customer already has keeps working.\n","title":"AutoPayPageLinkResponse"},"examples":{"CurrentLink":{"value":{"page_token":"tok_5c1e8b2f0a9d4e7b","page_url":"https://sandbox.ottu.net/en/subscription/tok_5c1e8b2f0a9d4e7b"},"summary":"Current link"}}}},"description":""},"401":{"content":{"application/json":{"schema":{"type":"object","properties":{"detail":{"type":"string"}},"required":["detail"],"title":"GenericErrorMessage"},"examples":{"NotAuthenticated":{"value":{"detail":"Authentication credentials were not provided."},"summary":"Not authenticated"}}}},"description":""},"404":{"content":{"application/json":{"schema":{"type":"object","properties":{"detail":{"type":"string"}},"required":["detail"],"title":"GenericErrorMessage"},"examples":{"UnknownSubscription":{"value":{"detail":"Not found","code":"subscription_not_found"},"summary":"Unknown subscription"}}}},"description":""},"423":{"content":{"application/json":{"schema":{"type":"object","properties":{"detail":{"type":"string"}},"required":["detail"],"title":"GenericErrorMessage"},"examples":{"InstallationPaused":{"value":{"detail":"Service is paused.","code":"